# Qdrant connection settings
# Leave QDRANT_HOST empty for a local run: step 2 will start a local Qdrant via
# Docker on localhost:LOCAL_QDRANT_PORT. Set it to your cloud URL for real runs.
QDRANT_HOST=http://your-qdrant-host:6333
QDRANT_API_KEY=your-api-key-here
QDRANT_PORT=443
QDRANT_TIMEOUT=10000

# Local Qdrant server, started by step 2 when QDRANT_HOST is empty (--qdrant docker)
LOCAL_QDRANT_PORT=6333
LOCAL_QDRANT_IMAGE=qdrant/qdrant:latest
LOCAL_QDRANT_CONTAINER=sum-estimation-qdrant
LOCAL_QDRANT_VOLUME=./qdrant_storage

# Serverless embedded Qdrant for --qdrant embedded: a directory, or :memory:
QDRANT_EMBEDDED_PATH=:memory:

# HNSW graph parameters and when Qdrant starts building the graph (step 2)
HNSW_M=32
HNSW_EF_CONSTRUCT=32
HNSW_FULL_SCAN_THRESHOLD=10000
INDEXING_THRESHOLD=10000

# Embedding files, shared by steps 1, 2 and 3: step 1 writes here, step 2 indexes
# from here, step 3 reads here for local ground truth. Point it at one directory
# per run so the three steps cannot disagree about which vectors they mean, e.g.
#   EMBEDDINGS_DIR=../embeddings/50k_run
EMBEDDINGS_DIR=../embeddings
# Number of independent rarity-level assignments stored per point (level_0..level_{N-1}).
# Each is an independent draw, enabling multiple runs with re-assigned levels.
NUM_LEVELS=10
# Geometric rarity draws are capped at this value
MAX_RARITY_IN_VECTOR_DB=40
# Where index metadata is recorded, one directory per collection:
#     <HNSW_INDEX_DIR>/<collection>/max_levels.json
HNSW_INDEX_DIR=../hnsw_index

# Experiment settings
# Where step 3 writes Parquet results and step 4 reads them. A local path or an
# S3 path (e.g. s3://bucket/path). Defaults to the repo-root experiments_results/.
RESULTS_PATH=../experiments_results

# Where step 4 writes figures. Defaults to the repo-root plots/.
PLOTS_DIR=../plots

# Number of dataset embeddings to load from Qdrant (trade-off: more items = slower true-sum computation)
# For quick reproduction: 50000-100000
# For full-scale experiments: increase toward the full dataset size
NUM_DATASET_EMBEDDINGS=100000

# Number of query candidate vectors to load (pool from which random queries are drawn)
NUM_QUERY_CANDIDATES=1000
